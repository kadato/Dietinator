{
  "name": "dietinator",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "buffer": "^6.0.3",
    "expo": "~56.0.6",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.16",
    "expo-linking": "~56.0.12",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-aria": "^3.33.0",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.13.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20",
    "yazio": "^1.1.3"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~56.0.13",
    "cross-env": "^10.1.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/expo-cli.cjs start",
    "dev": "node scripts/expo-cli.cjs start",
    "android": "node scripts/expo-cli.cjs start --android",
    "ios": "node scripts/expo-cli.cjs start --ios",
    "web": "node scripts/expo-cli.cjs start --web",
    "dev:web": "node scripts/expo-cli.cjs start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/expo-cli.cjs export --platform web",
    "serve:web": "node scripts/serve-dist.mjs",
    "web:prod": "npm run build:web && npm run serve:web",
    "test:e2e": "npm run build:web && playwright test",
    "test:e2e:headed": "npm run build:web && playwright test --headed",
    "test:e2e:dev": "cross-env PW_E2E_DEV=1 playwright test",
    "test:e2e:yazio": "npm run build:web && playwright test e2e/yazio.spec.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  }
}
