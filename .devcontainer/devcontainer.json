{
  "name": "Dietinator",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "workspaceFolder": "/workspaces/dietinator",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/dietinator,type=bind",
  "postCreateCommand": "npm ci",
  "forwardPorts": [8081, 8082, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": { "label": "Metro" },
    "8082": { "label": "Metro (alt)" },
    "19000": { "label": "Expo" },
    "19001": { "label": "Expo (devtools)" },
    "19002": { "label": "Expo (tunnel)" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node"
}
