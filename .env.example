# Copy to .env.local for local dev. Never commit real values.
# .env and .env*.local are gitignored and scanned by gitleaks in CI.
# For agents, prefer Bitwarden + direnv so no plaintext sits on disk.
# See .envrc.example for the vault pattern.

YAZIO_EMAIL=
YAZIO_PASSWORD=

# Optional: MCP API key for /mcp when serving web with auth
# MCP_API_KEY=
